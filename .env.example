CHATGPT_API_KEY=
PEXELS_API_KEY=
FAL_KEY=

# Required by every API endpoint. The username is always `admin`.
API_PASSWORD=

# Add one pair per app. The prefix is the app's upper-case `id` from
# data/apps.json; non-alphanumeric characters become underscores.
DRIVEPROOF_EMAIL=
DRIVEPROOF_PASSWORD=
WHAT2COOK_EMAIL=
WHAT2COOK_PASSWORD=

# Raspberry Pi OS commonly uses /usr/bin/chromium.
BROWSER_EXECUTABLE=/usr/bin/chromium

# Increase these values if TikTok is slow on the Raspberry Pi.
TIKTOK_TIMEOUT_SECONDS=90
TIKTOK_SETTLE_SECONDS=5
